# Copy to .env and fill in. .env is git-ignored and must never be committed.
#
# Phases 0-2 (target app, surfaces) need NOTHING in this file.
# Only the Phase 3 discovery agent reads these values.

# --- LLM provider seam -------------------------------------------------------
# The discovery agent depends on a tool-calling chat interface, not on a vendor.
# Pick one block below. Everything except "anthropic" speaks the OpenAI-
# compatible protocol, so a single adapter serves all of them.

LLM_PROVIDER=gemini

# gemini  -- free tier, no credit card. Key: https://aistudio.google.com/apikey
LLM_MODEL=gemini-2.5-flash
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=

# groq    -- free tier, no credit card. Key: https://console.groq.com/keys
# LLM_PROVIDER=groq
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=

# ollama  -- fully local, no key, no network. Weakest tool-calling; documented
#            fallback only.
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen2.5:7b
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama

# anthropic -- requires a paid console.anthropic.com key (a Claude subscription
#              does NOT grant API access).
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-5
# ANTHROPIC_API_KEY=

# --- target app --------------------------------------------------------------
TARGET_APP_HOST=127.0.0.1
TARGET_APP_PORT=5099
TARGET_APP_TENANT=meridian

# --- agent loop bounds (safety: every run is bounded) ------------------------
AGENT_MAX_STEPS=25
AGENT_WALL_CLOCK_S=300
